---

<section class="lines" id="categories">
  <div class="shell">
    <div class="head">
      <h2 class="h2">Six lines that work together.</h2>
      <p class="intro">
        Built for coffee houses: coffee goes in first, then the flavor. The same lines work in a
        dirty soda, a tea or a frappe.
      </p>
    </div>
    <div class="grid">
      <div class="steps" data-steps>
        {
          steps.map((step, i) => (
            <button
              type="button"
              class="step"
              data-step={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
              style={`--rail:${step.railColor}`}
            >
              <span class="num">{String(step.order).padStart(2, '0')}</span>
              <span class="text">
                <span class="eyebrow action">{step.kicker}</span>
                <span class="name">{step.title}</span>
                <span class="blurb">{step.description}</span>
              </span>
            </button>
          ))
        }
        <button type="button" class="playpause" data-playpause aria-pressed="true">
          <span class="glyph" aria-hidden="true" />
          <span data-playpause-label>Pause</span>
        </button>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="scene">
          {
            steps.map((step, i) => (
              <div class="pourer" data-pour={i} style={`--tip-x:${step.visual.tipX}; --tip-y:${step.visual.tipY}`}>
                <div class="halo">
                  <img
                    src={step.visual.image.src}
                    srcset={step.visual.image.srcset}
                    alt=""
                    sizes="180px"
                    loading="lazy"
                    decoding="async"
                    width={step.visual.image.width}
                    height={step.visual.image.height}
                  />
                </div>
                {step.visual.streamColor && (
                  <div class="stream" style={`--c:${step.visual.streamColor}`}>
                    <span class="stream-body" />
                    <span class="stream-bead" />
                  </div>
                )}
                {step.visual.grains.length > 0 && (
                  <div class="grains">
                    {step.visual.grains.map((g) => (
                      <span
                        style={`--dx:${g.dx}px; --d:${g.d}ms; width:${g.width}px; height:${g.height}px; background:${g.background}`}
                      />
                    ))}
                  </div>
                )}
              </div>
            ))
          }
          <div class="cup">
            <div class="fill">
              <span class="base">Coffee</span>
              {
                cupLayers.map((layer, i) => (
                  <span class="layer" data-layer={i} style={`--h:${layer.h}px; background:${layer.color}`} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('.lines');
  if (el) {
    const steps = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const pourers = Array.from(el.querySelectorAll<HTMLElement>('[data-pour]'));
    const layers = Array.from(el.querySelectorAll<HTMLElement>('[data-layer]'));
    const playpause = el.querySelector<HTMLButtonElement>('[data-playpause]');
    const label = el.querySelector<HTMLElement>('[data-playpause-label]');
    let active = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      active = i;
      steps.forEach((s, n) => s.setAttribute('aria-pressed', String(n === i)));
      pourers.forEach((p, n) => p.classList.toggle('is-active', n === i));
      layers.forEach((l, n) => l.classList.toggle('is-filled', n <= i));
    };
    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
      playpause?.setAttribute('aria-pressed', 'false');
      if (label) label.textContent = 'Play';
    };
    const play = () => {
      pause();
      timer = window.setInterval(() => show((active + 1) % steps.length), 2600);
      playpause?.setAttribute('aria-pressed', 'true');
      if (label) label.textContent = 'Pause';
    };

    steps.forEach((s, i) =>
      s.addEventListener('click', () => {
        show(i);
        pause();
      })
    );
    playpause?.addEventListener('click', () => (timer ? pause() : play()));
    show(0);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      pause();
    } else {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : pause()), {
        threshold: 0.25,
      }).observe(el);
    }
  }
</script>

<style>
  .lines {
    background: var(--cream);
    color: var(--ink);
    padding-block: clamp(64px, 9vw, 132px);
  }
  .head {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: end;
    gap: clamp(28px, 5vw, 72px);
    margin-bottom: clamp(40px, 6vw, 76px);
    display: grid;
  }
  .intro {
    color: var(--body-on-cream);
    max-width: 42ch;
  }
  .grid {
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    align-items: start;
    gap: clamp(32px, 5vw, 64px);
    display: grid;
  }
  .steps {
    gap: 2px;
    display: grid;
  }
  .step {
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    text-align: left;
    cursor: pointer;
    width: 100%;
    transition:
      background var(--t-hover),
      border-color var(--t-hover);
    background: none;
    border: 0;
    border-left: 2px solid transparent;
    gap: 20px;
    padding: 20px 22px;
    display: flex;
  }
  .step[aria-pressed='true'] {
    background: var(--cream-card);
    border-left-color: var(--rail);
  }
  .step:hover {
    background: var(--cream-card);
  }
  .num {
    letter-spacing: 0.04em;
    width: 38px;
    height: 38px;
    color: var(--secondary);
    transition:
      background var(--t-hover),
      color var(--t-hover),
      border-color var(--t-hover);
    border: 1px solid #1b0f2229;
    border-radius: 50%;
    flex: none;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    display: grid;
  }
  .step[aria-pressed='true'] .num {
    background: var(--rail);
    border-color: var(--rail);
    color: #fff;
  }
  .text {
    gap: 6px;
    display: grid;
  }
  .action {
    color: var(--rail);
  }
  .name {
    letter-spacing: -0.02em;
    font-size: 20px;
    font-weight: 900;
  }
  .blurb {
    color: var(--secondary);
    max-width: 40ch;
    font-size: 15px;
    line-height: 1.55;
  }
  .playpause {
    border-radius: var(--pill);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    height: 38px;
    color: var(--secondary);
    cursor: pointer;
    transition:
      border-color var(--t-hover),
      color var(--t-hover);
    background: none;
    border: 1px solid #1b0f2229;
    justify-self: start;
    align-items: center;
    gap: 10px;
    margin: 18px 0 0 22px;
    padding-inline: 18px;
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
  }
  .playpause:hover {
    border-color: var(--gold);
    color: var(--ink);
  }
  .glyph {
    clip-path: polygon(0 0, 3px 0, 3px 100%, 0 100%, 0 0, 6px 0, 9px 0, 9px 100%, 6px 100%);
    background: currentColor;
    width: 9px;
    height: 11px;
  }
  .playpause[aria-pressed='false'] .glyph {
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .stage {
    border-radius: var(--r-xl);
    background: var(--plum);
    place-items: center;
    min-height: 520px;
    padding: clamp(24px, 4vw, 48px);
    display: grid;
  }
  .scene {
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 260px;
    height: 470px;
    display: flex;
    position: relative;
  }
  .pourer {
    --halo: 150px;
    --bottle: 116px;
    --pour-x: 72px;
    --pour-y: 104px;
    width: var(--halo);
    height: var(--halo);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s;
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50%;
  }
  .pourer.is-active {
    opacity: 1;
    visibility: visible;
  }
  .halo {
    width: var(--halo);
    height: var(--halo);
    background: var(--cream-card);
    border-radius: 50%;
    position: relative;
    overflow: hidden;
  }
  .halo img {
    width: var(--bottle);
    height: auto;
    left: calc(var(--pour-x) - var(--tip-x) * var(--bottle));
    top: calc(var(--pour-y) - var(--tip-y) * var(--bottle));
    transform-origin: calc(var(--tip-x) * 100%) calc(var(--tip-y) * 100%);
    transition: rotate 0.9s var(--ease-out);
    position: absolute;
    rotate: 150deg;
  }
  .pourer:not(.is-active) img {
    rotate: 128deg;
  }
  .stream {
    left: var(--pour-x);
    top: var(--pour-y);
    width: 12px;
    height: 124px;
    position: absolute;
    overflow: hidden;
    translate: -50%;
  }
  .stream-body,
  .stream-bead {
    background: var(--c);
    border-radius: 9999px;
    position: absolute;
    left: 50%;
    translate: -50%;
  }
  .stream-body {
    width: 7px;
    height: 100%;
    animation: syrup-stream 1.5s var(--ease-out) infinite;
    top: 0;
  }
  .stream-bead {
    width: 11px;
    height: 13px;
    animation: syrup-bead 1.5s var(--ease-out) infinite;
    top: 0;
  }
  .grains {
    left: var(--pour-x);
    top: var(--pour-y);
    width: 120px;
    height: 140px;
    position: absolute;
    translate: -50%;
  }
  .grains span {
    animation: 1.6s linear infinite grain-fall;
    animation-delay: var(--d);
    border-radius: 2px;
    position: absolute;
    top: 0;
    left: 50%;
  }
  .cup {
    --layer-scale: 0.92;
    width: 176px;
    height: 300px;
    position: relative;
  }
  .cup::before {
    content: '';
    background: #efe6d8;
    border-radius: 6px;
    height: 16px;
    position: absolute;
    inset: 0 -10px auto;
  }
  .fill {
    clip-path: polygon(0 0, 100% 0, 86% 100%, 14% 100%);
    background: #2f1c3a;
    flex-direction: column-reverse;
    display: flex;
    position: absolute;
    inset: 16px 0 0;
    overflow: hidden;
  }
  .layer {
    width: 100%;
    height: 0;
    transition: height 0.9s var(--ease-out);
    flex: none;
  }
  .base {
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffffff6b;
    background: #3b2617;
    flex: none;
    place-items: center;
    width: 100%;
    height: 68px;
    font-size: 10px;
    font-weight: 700;
    display: grid;
  }
  .layer.is-filled {
    height: calc(var(--h) * var(--layer-scale));
  }
  @media (width <= 900px) {
    .stage {
      min-height: 460px;
    }
    .scene {
      transform: scale(0.86);
    }
  }
</style>
