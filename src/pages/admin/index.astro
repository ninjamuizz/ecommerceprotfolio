---
// Protected admin dashboard placeholder. Actual auth enforcement happens in
// src/middleware.ts (any unauthenticated request to /admin/* is redirected
// to /admin/login before this file's code ever runs) — the getSession() call
// below is just to read the logged-in username back out for display, plus a
// defense-in-depth fallback in case this page is ever reached some other way
// (e.g. middleware misconfiguration).
import { getSession } from '../../lib/auth-server';

export const prerender = false;

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login/', 302);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — Stirling Flavors</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="wrap">
      <h1>Admin dashboard</h1>
      <p>Signed in as <strong>{session.login}</strong>.</p>
      <a class="logout" href="/api/auth/logout/">Log out</a>
    </main>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, -apple-system, sans-serif;
        background: #f7f2ef;
        color: #1b0f22;
      }
      .wrap {
        max-width: 28rem;
        padding: 2.5rem;
        text-align: center;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.75rem;
      }
      p {
        margin: 0 0 1.75rem;
      }
      .logout {
        color: #7a3b12;
        text-decoration: underline;
      }
    </style>
  </body>
</html>
