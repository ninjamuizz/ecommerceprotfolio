---
// Admin: searchable/filterable list of all 65 recipes, linking to each one's
// editor at /admin/recipes/{slug}/.
export const prerender = false;

import { requireSession } from '../../../lib/auth-server';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readRecipes } from '../../../lib/content-store';
import { RECIPE_CATEGORIES } from '../../../lib/content-schema';

const session = requireSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login/');
}

const recipes = readRecipes();
---

<BaseLayout title="Recipes — Admin" showHeader={false} showFooter={false} background="cream">
  <section class="shell">
    <div class="head">
      <div>
        <p class="eyebrow">Admin</p>
        <h1>Recipes</h1>
        <p class="count" data-count>{recipes.length} recipes</p>
      </div>
      <label class="sr-only" for="search">Search recipes</label>
      <input id="search" type="search" placeholder="Search by name or category" data-search autocomplete="off" />
    </div>

    <div class="filters" role="group" aria-label="Filter by category">
      <button type="button" class="chip" data-filter="All" aria-pressed="true">All</button>
      {
        RECIPE_CATEGORIES.map((cat) => (
          <button type="button" class="chip" data-filter={cat} aria-pressed="false">
            {cat}
          </button>
        ))
      }
    </div>

    <table class="list">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Made with</th>
        </tr>
      </thead>
      <tbody data-rows>
        {
          recipes.map((r) => (
            <tr data-row data-name={r.name.toLowerCase()} data-category={r.category}>
              <td>
                <a href={`/admin/recipes/${r.slug}/`}>{r.name}</a>
              </td>
              <td>{r.category}</td>
              <td>{r.madeWith.join(', ')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="empty" data-empty hidden>No recipes match that search.</p>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-row]'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let activeFilter = 'All';

  function update() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let n = 0;
    rows.forEach((row) => {
      const inFilter = activeFilter === 'All' || row.dataset.category === activeFilter;
      const inSearch =
        !q || (row.dataset.name ?? '').includes(q) || (row.dataset.category ?? '').toLowerCase().includes(q);
      const visible = inFilter && inSearch;
      row.hidden = !visible;
      if (visible) n += 1;
    });
    if (count) count.textContent = `${n} ${n === 1 ? 'recipe' : 'recipes'}`;
    if (empty) empty.hidden = n > 0;
  }

  filters.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'All';
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      update();
    })
  );
  search?.addEventListener('input', update);
  update();
</script>

<style>
  .shell {
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px var(--gutter) 96px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 24px;
  }
  .eyebrow {
    color: var(--gold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 4px;
  }
  h1 {
    margin: 0;
    font-size: 32px;
  }
  .count {
    color: var(--muted);
    margin: 4px 0 0;
    font-size: 13px;
  }
  #search {
    height: 44px;
    width: min(320px, 100%);
    border-radius: var(--pill);
    border: 1px solid #1b0f2229;
    padding-inline: 18px;
    font-size: 14px;
    background: #fff;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .chip {
    border-radius: var(--pill);
    border: 1px solid #1b0f2229;
    background: none;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: var(--plum);
    border-color: var(--plum);
    color: #fff;
  }
  .list {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-light);
  }
  .list th,
  .list td {
    text-align: left;
    padding: 10px 14px;
    font-size: 13px;
    border-bottom: 1px solid #1b0f2214;
  }
  .list th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .list a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .list a:hover {
    color: var(--gold);
  }
  tr[hidden] {
    display: none;
  }
  .empty {
    text-align: center;
    color: var(--secondary);
    margin-top: 32px;
  }
</style>
