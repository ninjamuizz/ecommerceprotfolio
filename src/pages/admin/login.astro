---
// Public login page — deliberately NOT guarded by middleware (see
// src/middleware.ts, which excludes /admin/login by name). If someone is
// already logged in, just send them straight to the dashboard instead of
// showing a pointless "log in" button.
import { getSession } from '../../lib/auth-server';

export const prerender = false;

const session = getSession(Astro.cookies);
if (session) {
  return Astro.redirect('/admin/', 302);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin login — Stirling Flavors</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="wrap">
      <h1>Stirling Flavors admin</h1>
      <p>Sign in with the GitHub account authorized to edit this site's content.</p>
      <a class="button" href="/api/auth/github/start/">Sign in with GitHub</a>
    </main>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, -apple-system, sans-serif;
        background: #1b0f22;
        color: #f7f2ef;
      }
      .wrap {
        max-width: 28rem;
        padding: 2.5rem;
        text-align: center;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.75rem;
      }
      p {
        opacity: 0.8;
        margin: 0 0 1.75rem;
        line-height: 1.5;
      }
      .button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #f7f2ef;
        color: #1b0f22;
        text-decoration: none;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 999px;
      }
      .button:hover {
        opacity: 0.9;
      }
    </style>
  </body>
</html>
