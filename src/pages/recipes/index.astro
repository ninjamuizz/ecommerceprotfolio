---
import BaseLayout from '../../layouts/BaseLayout.astro';
import recipes from '../../data/recipes.json';
import flavors from '../../data/flavors.json';
import recipeProductLinks from '../../data/recipe-product-links.json';
import recipeImages from '../../data/recipe-images.json';
import {
  recipeTypes,
  madeWithValues,
  profileValues,
  seasonValues,
  splitTags,
} from '../../lib/recipe-content';
import { shortName } from '../../lib/flavor-content';

// Card art: reuses the exact same per-recipe hero image as the detail page
// (verified byte-identical src/srcset/width/height between
// reference/pages/recipe-{slug}.html's .art image and recipes-index.html's
// own card .art image for all 65 recipes — see NOTES.md). The reference
// page's own card `sizes` string differs from the detail page's
// ("(max-width: 640px) 90vw, 420px" vs "(max-width: 900px) 90vw, 420px") —
// kept as its own literal here, not shared with [slug].astro.
const images = recipeImages as Record<string, { src: string; srcset: string; width: number; height: number }>;

const flavorList = flavors as Array<{
  name: string;
  slug: string;
  category: string;
  categorySlug: string;
}>;
const productLinks = recipeProductLinks as Record<string, Array<{ categorySlug: string; slug: string }>>;

function productsFor(slug: string) {
  return (productLinks[slug] ?? [])
    .map((link) => flavorList.find((f) => f.categorySlug === link.categorySlug && f.slug === link.slug))
    .filter((f): f is (typeof flavorList)[number] => !!f);
}
---

<BaseLayout
  title="Recipes — Stirling Flavors"
  description="Sixty-five drink builds from Stirling Flavors — lattes, mochas, frappes, teas, cocktails and dirty sodas, each layered from two or three Stirling products."
  background="cream"
>
  <section class="library">
    <div class="shell">
      <header class="head">
        <p class="eyebrow gold">Recipes</p>
        <h1 class="h2">Stack the flavors.</h1>
        <p class="lead">
          A Stirling drink is never just one bottle. Every build here layers two or three products into
          something you can't pour from one. Start with what you're making.
        </p>
      </header>

      <ul class="types" data-types>
        {
          recipeTypes.map((t, i) => {
            const count = recipes.filter((r) => r.category === t.type).length;
            return (
              <li>
                <button
                  type="button"
                  data-type={t.type}
                  data-slug={t.slug}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  style={`--type:${t.color}`}
                >
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="name">{t.type}</span>
                  <span class="type-note">{t.note}</span>
                  <span class="count">{count}</span>
                  <span class="dot" aria-hidden="true" />
                </button>
              </li>
            );
          })
        }
      </ul>

      <div class="facets">
        <div class="facet">
          <p class="facet-label">Made with</p>
          <div class="pills">
            {madeWithValues.map((v) => (
              <button type="button" class="pill" data-facet="lines" data-value={v} aria-pressed="false">
                {v}
              </button>
            ))}
          </div>
        </div>
        <div class="facet">
          <p class="facet-label">Flavor</p>
          <div class="pills">
            {profileValues.map((v) => (
              <button type="button" class="pill" data-facet="profiles" data-value={v} aria-pressed="false">
                {v}
              </button>
            ))}
          </div>
        </div>
        <div class="facet">
          <p class="facet-label">Season</p>
          <div class="pills">
            {seasonValues.map((v) => (
              <button type="button" class="pill" data-facet="seasons" data-value={v} aria-pressed="false">
                {v}
              </button>
            ))}
          </div>
        </div>
        <div class="facet measure">
          <p class="facet-label">Measures</p>
          <div class="seg" role="group" aria-label="Measurement style">
            <button type="button" data-measure="home" aria-pressed="true">Home</button>
            <button type="button" data-measure="cafe" aria-pressed="false">Café · pumps</button>
          </div>
        </div>
      </div>

      <div class="status">
        <p class="count-line" role="status" data-count></p>
        <button type="button" class="clear" data-clear hidden>Clear filters</button>
      </div>

      <ul class="grid" data-grid>
        {
          recipes.map((r) => {
            const { profiles, seasons } = splitTags(r.tags);
            const linesText = r.madeWith.length > 0 ? r.madeWith.join(' + ') : r.category;
            const img = images[r.slug];
            const products = productsFor(r.slug);
            return (
              <li
                class="cell"
                data-recipe
                data-type={r.category}
                data-lines={r.madeWith.join('|')}
                data-profiles={profiles.join('|')}
                data-seasons={seasons.join('|')}
              >
                <article class="card" style={`--type:${(recipeTypes.find((t) => t.type === r.category) ?? recipeTypes[0]).color}`}>
                  <div class="art">
                    {img && (
                      <img
                        src={img.src}
                        srcset={img.srcset}
                        alt={r.name}
                        sizes="(max-width: 640px) 90vw, 420px"
                        loading="lazy"
                        decoding="async"
                        width={img.width}
                        height={img.height}
                      />
                    )}
                  </div>
                  <div class="body">
                    <h2 class="r-name">{r.name}</h2>
                    <p class="r-lines">{linesText}</p>
                    <button type="button" class="expand" aria-expanded="false">
                      <span class="expand-open">The build</span>
                      <span class="expand-close">Hide</span>
                    </button>
                    <div class="detail" hidden>
                      <p class="d-label">Ingredients</p>
                      <ul class="d-list" data-home>
                        {r.ingredients.map((ing) => <li>{ing.home}</li>)}
                      </ul>
                      <ul class="d-list" data-cafe hidden>
                        {r.ingredients.map((ing) => <li>{ing.cafe}</li>)}
                      </ul>
                      <p class="d-label">Build</p>
                      <p class="d-build">{r.method}</p>
                      <p class="d-label">Products used</p>
                      <ul class="d-products">
                        {products.map((p) => (
                          <li>
                            <a href={`/flavors/${p.categorySlug}/${p.slug}/`}>{shortName(p.name, p.category)}</a>
                          </li>
                        ))}
                      </ul>
                      {r.swap && (
                        <p class="d-swap">
                          <b>Swap it</b>{r.swap}
                        </p>
                      )}
                      {r.spike && (
                        <p class="d-spike">
                          <b>Spike it</b>{r.spike}
                        </p>
                      )}
                      <a class="d-full" href={`/recipes/${r.slug}/`}>Full recipe</a>
                    </div>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>

      <p class="empty" data-empty hidden>Nothing matches that combination. Try loosening a filter.</p>
      <p class="note" data-archive-note hidden>
        Archive recipes aren't tagged for flavor or season, so they're hidden while those filters are on.
      </p>
    </div>
  </section>

  <script>
    // Ported verbatim from the source's recipes-index inline module. Two
    // real corrections vs. the brief (see NOTES.md):
    //  1. There is no query-string persistence anywhere in this script — no
    //     history.pushState/replaceState, no URLSearchParams writes. Only the
    //     single `type` tab is restorable on load, via `location.hash`
    //     matching a button's data-slug (e.g. /recipes/#lattes) — the
    //     lines/profiles/seasons facets are never written to the URL at all.
    //  2. There are no real `id="lattes"` etc. anchors in the DOM (grepped:
    //     zero matches) — the six "sections" are one filterable card grid,
    //     not six separate page sections; `#lattes` only works because this
    //     script reads location.hash to preselect the matching type tab.
    const root = document.querySelector<HTMLElement>('.library');
    if (root) {
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-recipe]'));
      const typeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-type]'));
      const facetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-facet]'));
      const measureButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-measure]'));
      const countEl = root.querySelector<HTMLElement>('[data-count]');
      const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]');
      const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
      const archiveNote = root.querySelector<HTMLElement>('[data-archive-note]');

      const state: { type: string; lines: Set<string>; profiles: Set<string>; seasons: Set<string> } = {
        type: typeButtons[0]?.dataset.type ?? '',
        lines: new Set(),
        profiles: new Set(),
        seasons: new Set(),
      };

      const values = (el: HTMLElement, key: string) => (el.dataset[key] ?? '').split('|').filter(Boolean);

      const update = () => {
        let n = 0;
        for (const card of cards) {
          const matchesType = card.dataset.type === state.type;
          const matchesLines = state.lines.size === 0 || values(card, 'lines').some((v) => state.lines.has(v));
          const matchesProfiles = state.profiles.size === 0 || values(card, 'profiles').some((v) => state.profiles.has(v));
          const matchesSeasons = state.seasons.size === 0 || values(card, 'seasons').some((v) => state.seasons.has(v));
          const visible = matchesType && matchesLines && matchesProfiles && matchesSeasons;
          card.hidden = !visible;
          if (visible) n += 1;
        }
        if (countEl) countEl.textContent = `${n} ${n === 1 ? 'recipe' : 'recipes'} in ${state.type}`;
        const anyFacet = state.lines.size || state.profiles.size || state.seasons.size;
        if (clearBtn) clearBtn.hidden = !anyFacet;
        if (emptyEl) emptyEl.hidden = n > 0;
        if (archiveNote) archiveNote.hidden = !(state.profiles.size || state.seasons.size);
      };

      const setType = (type: string) => {
        state.type = type;
        typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === type)));
        update();
      };

      typeButtons.forEach((b) => b.addEventListener('click', () => setType(b.dataset.type ?? '')));

      facetButtons.forEach((b) =>
        b.addEventListener('click', () => {
          const facet = b.dataset.facet as 'lines' | 'profiles' | 'seasons';
          const value = b.dataset.value ?? '';
          const set = state[facet];
          if (set.has(value)) set.delete(value);
          else set.add(value);
          b.setAttribute('aria-pressed', String(set.has(value)));
          update();
        })
      );

      clearBtn?.addEventListener('click', () => {
        state.lines.clear();
        state.profiles.clear();
        state.seasons.clear();
        facetButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        update();
      });

      const setMeasure = (mode: string) => {
        measureButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.measure === mode)));
        root.querySelectorAll<HTMLElement>('[data-home]').forEach((el) => {
          el.hidden = mode !== 'home';
        });
        root.querySelectorAll<HTMLElement>('[data-cafe]').forEach((el) => {
          el.hidden = mode !== 'cafe';
        });
      };
      measureButtons.forEach((b) => b.addEventListener('click', () => setMeasure(b.dataset.measure ?? 'home')));

      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.expand');
        if (!btn) return;
        const detail = btn.nextElementSibling as HTMLElement | null;
        if (!detail) return;
        const willShow = detail.hidden;
        detail.hidden = !willShow;
        btn.setAttribute('aria-expanded', String(willShow));
      });

      const initial = typeButtons.find((b) => `#${b.dataset.slug}` === location.hash)?.dataset.type ?? state.type;
      setType(initial);
    }
  </script>
</BaseLayout>

<style>
  .library {
    background: var(--cream);
    color: var(--ink);
    padding-block: clamp(48px, 7vw, 88px) clamp(72px, 9vw, 120px);
  }
  .gold {
    color: var(--gold);
    margin-bottom: 18px;
  }
  .lead {
    max-width: 56ch;
    color: var(--body-on-cream);
    margin-top: 22px;
    font-size: 19px;
    line-height: 1.68;
  }
  .types {
    border-top: 1px solid #1b0f221f;
    margin: clamp(36px, 5vw, 56px) 0 0;
    padding: 0;
    list-style: none;
  }
  .types li {
    border-bottom: 1px solid #1b0f221f;
  }
  .types button {
    text-align: left;
    cursor: pointer;
    width: 100%;
    color: inherit;
    transition: background var(--t-card), color var(--t-card), padding-left var(--t-card);
    background: none;
    border: 0;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr) auto auto;
    align-items: center;
    gap: clamp(14px, 3vw, 40px);
    padding: clamp(15px, 2vw, 22px) clamp(12px, 2vw, 22px);
    display: grid;
  }
  .types button:hover,
  .types button[aria-pressed='true'] {
    background: var(--type);
    color: #fff;
    padding-left: clamp(18px, 3vw, 32px);
  }
  .num {
    letter-spacing: 0.14em;
    color: var(--muted);
    transition: color var(--t-card);
    font-size: 12px;
    font-weight: 600;
  }
  .name {
    letter-spacing: -0.03em;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 900;
    line-height: 1.05;
  }
  .type-note {
    color: var(--secondary);
    transition: color var(--t-card);
    font-size: 14px;
  }
  .count {
    letter-spacing: 0.14em;
    color: var(--muted);
    transition: color var(--t-card);
    font-size: 12px;
    font-weight: 700;
  }
  .dot {
    background: var(--type);
    width: 20px;
    height: 20px;
    transition: background var(--t-card);
    border-radius: 50%;
  }
  .types button:hover .num,
  .types button:hover .type-note,
  .types button:hover .count,
  .types button[aria-pressed='true'] .num,
  .types button[aria-pressed='true'] .type-note,
  .types button[aria-pressed='true'] .count {
    color: #ffffffc7;
  }
  .types button:hover .dot,
  .types button[aria-pressed='true'] .dot {
    background: #fff;
  }
  .facets {
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 22px 32px;
    margin-top: clamp(28px, 4vw, 40px);
    display: flex;
  }
  .facet-label {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 9px;
    font-size: 10px;
    font-weight: 700;
  }
  .pills {
    flex-wrap: wrap;
    gap: 8px;
    display: flex;
  }
  .pill {
    border-radius: var(--pill);
    letter-spacing: 0.06em;
    height: 34px;
    color: var(--secondary);
    cursor: pointer;
    transition: background var(--t-hover), border-color var(--t-hover), color var(--t-hover);
    background: none;
    border: 1px solid #1b0f2229;
    padding-inline: 16px;
    font-size: 12px;
    font-weight: 600;
  }
  .pill:hover {
    border-color: var(--gold);
    color: var(--ink);
  }
  .pill[aria-pressed='true'] {
    background: var(--plum);
    border-color: var(--plum);
    color: #fff;
  }
  .measure {
    margin-left: auto;
  }
  .seg {
    border-radius: var(--pill);
    background: #fff;
    border: 1px solid #1b0f2229;
    padding: 3px;
    display: inline-flex;
  }
  .seg button {
    border-radius: var(--pill);
    color: var(--secondary);
    cursor: pointer;
    transition: background var(--t-hover), color var(--t-hover);
    background: none;
    border: 0;
    padding: 7px 15px;
    font-size: 12px;
    font-weight: 700;
  }
  .seg button[aria-pressed='true'] {
    background: var(--plum);
    color: #fff;
  }
  .status {
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 30px;
    display: flex;
  }
  .count-line {
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0;
    font-size: 13px;
  }
  .clear {
    color: var(--gold);
    cursor: pointer;
    background: none;
    border: 0;
    padding: 4px 2px;
    font-size: 13px;
    font-weight: 700;
  }
  .clear[hidden] {
    display: none;
  }
  .grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    align-items: start;
    gap: 20px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .cell[hidden] {
    display: none;
  }
  .card {
    border-radius: var(--r-md);
    box-shadow: var(--shadow-light);
    transition: box-shadow var(--t-card);
    background: #fff;
    display: grid;
    overflow: hidden;
  }
  .card:hover {
    box-shadow: var(--shadow-card-hover);
  }
  .art {
    aspect-ratio: 1;
    overflow: hidden;
  }
  .art img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .body {
    padding: 18px 20px 20px;
  }
  .r-name {
    letter-spacing: -0.02em;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
  }
  .r-lines {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 7px;
    font-size: 11px;
    font-weight: 600;
    display: flex;
  }
  .expand {
    border-radius: var(--pill);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    transition: background var(--t-hover), border-color var(--t-hover), color var(--t-hover);
    background: none;
    border: 1px solid #1b0f2229;
    margin-top: 14px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 700;
  }
  .expand:hover {
    background: var(--type);
    border-color: var(--type);
    color: #fff;
  }
  .expand-close,
  .expand[aria-expanded='true'] .expand-open {
    display: none;
  }
  .expand[aria-expanded='true'] .expand-close {
    display: inline;
  }
  .detail {
    border-top: 1px solid #1b0f221a;
    margin-top: 16px;
    padding-top: 16px;
  }
  .detail[hidden] {
    display: none;
  }
  .d-label {
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 7px;
    font-size: 10px;
    font-weight: 700;
  }
  .d-label:not(:first-child) {
    margin-top: 16px;
  }
  .d-list {
    color: var(--body-on-cream);
    margin: 0;
    padding-left: 17px;
    font-size: 14px;
    line-height: 1.55;
  }
  .d-list[hidden] {
    display: none;
  }
  .d-build {
    color: var(--body-on-cream);
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }
  .d-products {
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
  }
  .d-products a {
    border-radius: var(--pill);
    color: var(--body-on-cream);
    transition: background var(--t-hover), border-color var(--t-hover), color var(--t-hover);
    border: 1px solid #1b0f2229;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 600;
    display: inline-block;
  }
  .d-products a:hover {
    background: var(--type);
    border-color: var(--type);
    color: #fff;
  }
  .d-swap,
  .d-spike {
    border-radius: var(--r-sm);
    gap: 3px;
    margin: 16px 0 0;
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.5;
    display: grid;
  }
  .d-swap {
    background: var(--cream-card);
    color: var(--body-on-cream);
  }
  .d-spike {
    background: var(--plum);
    color: #ffffffd1;
  }
  .d-swap b,
  .d-spike b {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
  }
  .d-full {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--gold);
    margin-top: 16px;
    padding-bottom: 2px;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .empty,
  .note {
    color: var(--secondary);
    margin-top: 32px;
  }
  .empty[hidden],
  .note[hidden] {
    display: none;
  }
  @media (width <= 860px) {
    .types button {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: 5px;
    }
    .type-note {
      grid-column: 2 / -1;
    }
    .count {
      grid-column: 2 / 3;
    }
    .dot {
      grid-area: 1 / 3;
    }
    .measure {
      margin-left: 0;
    }
  }
</style>
