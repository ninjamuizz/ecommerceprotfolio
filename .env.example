# Copy this file to .env for local development (npm run dev) and fill in
# real values. In Vercel, set these same names under Project Settings ->
# Environment Variables instead — see SETUP.md for the full walkthrough.

# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps
# on GitHub). Authorization callback URL must be:
#   https://<your-vercel-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to log into /admin.
# Example: ADMIN_GITHUB_USERNAMES=octocat,someoneelse
ADMIN_GITHUB_USERNAMES=

# Long random secret used to encrypt the admin session cookie (which embeds
# the signed-in user's GitHub token, so this must be kept confidential, not
# just "hard to guess"). Generate once with: openssl rand -hex 32
SESSION_SECRET=

# The GitHub repo content edits get committed to (github-commit.ts) and the
# rename tool's build-check status gets polled from. Must be the same repo
# this site deploys from.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Defaults to "main" if unset.
GITHUB_REPO_BRANCH=
